{
  "id": "ec-azuay-cuenca-denominadores",
  "nombre": "Denominadores de normalizacion — canton Cuenca",
  "version": "0.1",

  "estado": "PENDIENTE — ningun denominador oficial integrado",

  "porQueExisteVACIO": "La normalizacion es obligatoria y visible (UX-WR-001 §6.3). Este fichero es su punto de inyeccion. Se crea con TODAS las unidades y TODOS los valores en null, y no con estimaciones, porque el precedente que origino GEO-1 fue exactamente eso: repartir un dato provincial segun peso poblacional produjo penetraciones del 134 % y el 238 %. Un denominador inventado no degrada la respuesta, la invierte.",

  "reglaDura": "Sin denominador oficial NO se calcula ninguna metrica per capita, ningun porcentaje poblacional y ninguna intensidad relativa. El normalizador devuelve `disponible:false` con motivo y la UI muestra «Dato oficial pendiente de integracion». No hay ruta de codigo que estime un denominador ausente.",

  "fuentes": {
    "poblacion": {
      "organismo": "INEC",
      "referencia": "Censo de Poblacion y Vivienda — proyecciones por parroquia",
      "integrado": false,
      "url": null
    },
    "padronElectoral": {
      "organismo": "CNE",
      "referencia": "Padron electoral por parroquia / junta receptora del voto",
      "integrado": false,
      "url": null
    },
    "superficieKm2": {
      "organismo": "GAD Municipal de Cuenca / INEC",
      "referencia": "Calculo sobre geometria oficial en EPSG:32717 (UTM 17S)",
      "integrado": false,
      "url": null,
      "nota": "La superficie NO se calcula sobre Web Mercator: distorsiona el area. Depende del GeoJSON oficial, hoy ausente."
    }
  },

  "comoIntegrar": [
    "1. Rellenar `valor` y `fuente` en cada unidad de `denominadores`.",
    "2. Poner `verificado: true` solo cuando el dato provenga del organismo citado, no de una nota de prensa.",
    "3. Actualizar `integrado: true` en el bloque `fuentes` correspondiente.",
    "4. No hace falta tocar una sola linea de codigo: normalizer.js lee este fichero."
  ],

