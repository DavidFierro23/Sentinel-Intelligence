# apps/backend/.env.example
#
# PLANTILLA. Copiar a `.env` y rellenar.
#
# Este fichero SOLO contiene nombres de variable. Nunca un
# valor real: se versiona, y una clave versionada es una clave
# quemada aunque se borre despues —queda en el historial—.
#
# `.env` esta en .gitignore y debe seguir estandolo.
#
# Sentinel arranca SIN ninguna de estas claves. Cada proveedor
# sin credencial se declara SIN_CREDENCIAL y la plataforma
# sigue funcionando con los que si la tengan. Lo que NO se
# puede hacer sin credencial es afirmar ausencia: si no se le
# preguntó a un motor, su silencio no es un cero.


# ===========================================================
# SERVIDOR
# ===========================================================

PORT=3001


# ===========================================================
# BUSCADORES WEB
# ===========================================================

# SerpAPI — proveedor web principal.
# Saldo MENSUAL compartido con el Discovery Engine: gastarlo
# desde el modulo territorial deja sin cuota la funcion
# principal de la plataforma.
# https://serpapi.com/
SERPAPI_KEY=

# Brave Search — adapter completo, a la espera de credencial.
# En cuanto se define, entra en el registro sin tocar codigo.
# https://brave.com/search/api/
BRAVE_API_KEY=


# ===========================================================
# PLATAFORMAS
# ===========================================================

# YouTube Data API v3.
# 10.000 unidades/dia en el nivel gratuito; una busqueda cuesta
# 100, asi que son 100 busquedas diarias. No es dinero: es
# presupuesto.
#
# Desbloquea la identificacion de los emisores detras de
# YouTube, que hoy son el 40 % del corpus real sin identificar.
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=


# ===========================================================
# META — DOS FAMILIAS DE TOKEN, NO INTERCAMBIABLES
# ===========================================================
#
# Cada host de Meta acepta UNA familia y rechaza la otra. No es
# una preferencia: `graph.facebook.com` con un token de
# Instagram Login devuelve 400 code 190 «Cannot parse access
# token», que parece un token roto y no lo es.
#
#   graph.instagram.com   INSTAGRAM_ACCESS_TOKEN
#   graph.facebook.com    FACEBOOK_USER_ACCESS_TOKEN
#
# Sentinel elige el token por host y NO usa uno como respaldo
# del otro. Si falta el que toca, la llamada no se hace.

# Flujo: Instagram Login. Alcanza NUESTRA cuenta profesional y
# su contenido. Medido y funcionando (META-IG-REAL-01).
INSTAGRAM_ACCESS_TOKEN=

# Flujo: Facebook Login for Business. Es el UNICO que puede
# intentar terceros: `business_discovery` de una cuenta
# profesional ajena y la lectura de una Page ajena.
#
# Tenerlo no significa alcanzar a un candidato: el alcance lo
# decide el nivel de acceso de la app. Standard Access solo
# llega a usuarios y Paginas con un rol en la app, y un
# candidato nunca lo tendra.
FACEBOOK_USER_ACCESS_TOKEN=

# Version de la Graph API. Por defecto v23.0.
META_API_VERSION=


# ===========================================================
# ALMACENAMIENTO
# ===========================================================

# Adaptador del Knowledge Lake: `fichero` (por defecto),
# `memoria` o `minio`.
SENTINEL_LAKE_ADAPTER=fichero


# ===========================================================
# SIN CREDENCIAL
# ===========================================================
#
# Estos proveedores no necesitan nada y funcionan hoy:
#
#   google_news   RSS publico de Google News
#   rss_directo   feeds declarados por cada medio
#   gdelt_doc     API publica DOC 2.0
#   ddg_web       raspado de HTML publico, ultimo recurso
