node_modules/
.env
.env.*

# La PLANTILLA sí se versiona: solo contiene nombres de
# variable, nunca valores. Es lo que permite que alguien
# levante el proyecto sabiendo qué claves hacen falta.
!.env.example
!**/.env.example

dist/
dist-ssr/
build/
coverage/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Knowledge Lake — datos locales, no se versionan
apps/backend/data/
data/knowledge-lake/

# Logs del wrapper de backup programado — operativos, locales,
# nunca contienen secretos pero tampoco pertenecen al historial
apps/backend/scripts/backup/logs/

# Staging temporal del backup offsite (se regenera en cada corrida)
apps/backend/.backup-staging/

# Paquete cifrado de recuperación de secretos — nunca debe versionarse,
# ni siquiera cifrado: git no es su lugar, R2 es su lugar.
apps/backend/scripts/secrets/output/
