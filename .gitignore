# La PLANTILLA sí se versiona: solo contiene nombres de
# variable, nunca valores. Es lo que permite que alguien
# levante el proyecto sabiendo qué claves hacen falta.
!.env.example
!**/.env.example

dist/
dist-ssr/
build/
coverage/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Knowledge Lake — datos locales, no se versionan
apps/backend/data/
data/knowledge-lake/
